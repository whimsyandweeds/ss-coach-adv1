    <script>
        let currentIndex = 0;
        const totalSlides = 4;
        const track = document.getElementById('slideTrack');
        const counter = document.getElementById('slideCounter');
        const dots = document.querySelectorAll('.dot');

        function updateSlide() {
            track.style.transform = `translateX(-${currentIndex * 100}%)`;
            counter.innerText = `${currentIndex + 1} / ${totalSlides}`;
            
            dots.forEach((dot, index) => {
                if (index === currentIndex) {
                    dot.classList.remove('h-1.5', 'bg-white/40');
                    dot.classList.add('h-6', 'bg-white');
                } else {
                    dot.classList.remove('h-6', 'bg-white');
                    dot.classList.add('h-1.5', 'bg-white/40');
                }
            });
        }

        function nextSlide() {
            if (currentIndex < totalSlides - 1) {
                currentIndex++;
            } else {
                currentIndex = 0; // Loop back
            }
            updateSlide();
        }

        function prevSlide() {
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = totalSlides - 1;
            }
            updateSlide();
        }

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                nextSlide();
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                prevSlide();
            }
        });

        // Touch Swipe Navigation
        let startX = 0;
        let endX = 0;
        const viewport = document.getElementById('deckViewport');

        viewport.addEventListener('touchstart', (e) => {
            startX = e.changedTouches[0].screenX;
        }, false);

        viewport.addEventListener('touchend', (e) => {
            endX = e.changedTouches[0].screenX;
            handleSwipe();
        }, false);

        function handleSwipe() {
            const threshold = 40;
            if (startX - endX > threshold) {
                nextSlide();
            } else if (endX - startX > threshold) {
                prevSlide();
            }
        }
    </script>
